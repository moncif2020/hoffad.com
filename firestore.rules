rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function isValidUrl(url) {
      return url is string && url.size() <= 2048 && url.matches('^https?://.*');
    }

    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId || isLinked(userId));
    }

    function isLinked(userId) {
      // Allow an anonymous computer/TV session to access data if explicitly linked
      // sessionId matches the anonymous TV's request.auth.uid
      return exists(/databases/$(database)/documents/tv_sessions/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/tv_sessions/$(request.auth.uid)).data.get('uid', '') == userId &&
             get(/databases/$(database)/documents/tv_sessions/$(request.auth.uid)).data.status == 'linked';
    }

    // --- Entity Validations ---
    function isValidProfile() {
      let data = incoming();
      return data.keys().hasAll(['displayName', 'updatedAt']) &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (data.get('photoURL', '') is string && data.get('photoURL', '').size() <= 2048) &&
             (data.get('countryCode', '') is string && data.get('countryCode', '').size() <= 10) &&
             data.updatedAt == request.time;
    }

    function isValidLesson() {
      let data = incoming();
      return data.keys().hasAll(['title', 'text', 'type', 'createdAt']) &&
             data.title is string && data.title.size() <= 200 &&
             data.text is string && data.text.size() <= 100000 &&
             data.type in ['quran', 'custom'] &&
             data.createdAt <= request.time;
    }

    function isValidTVSession() {
      let data = incoming();
      return data.keys().hasAll(['status', 'deviceId', 'updatedAt']) &&
             data.status in ['waiting', 'linked', 'active'] &&
             isValidId(data.deviceId) &&
             data.updatedAt == request.time;
    }

    function isValidRemoteUpload() {
      let data = incoming();
      return data.keys().hasAll(['deviceId', 'anonUid', 'type', 'url', 'createdAt', 'userId']) &&
             isValidId(data.deviceId) &&
             isValidId(data.anonUid) &&
             data.type in ['image', 'audio', 'video'] &&
             isValidUrl(data.url) &&
             data.userId == request.auth.uid &&
             data.createdAt == request.time;
    }

    // --- Rules ---

    match /users/{userId} {
      // Secure List Query: Can only see your own profile or profiles of users you are linked to
      allow list: if isSignedIn() && (request.auth.uid == userId || isLinked(userId));
      
      // Profiles are only readable by owner or linked TV
      allow get: if isOwner(userId);
      
      allow create: if isOwner(userId) && isValidProfile();
      
      allow update: if isOwner(userId) && 
                       isValidProfile() && 
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'xp', 'coins', 'totalScore', 'countryCode', 'updatedAt']);
      
      allow delete: if false; // Profiles shouldn't be deleted easily

      match /lessons/{lessonId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidLesson();
        allow update: if isOwner(userId) && 
                         isValidLesson() && 
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'text', 'type', 'audioUrl', 'lang', 'updatedAt']);
        allow delete: if isOwner(userId);
      }
    }

    match /tv_sessions/{sessionId} {
      allow get: if isValidId(sessionId) && (
        !isSignedIn() || // Allow TV to check its own session status before it has fully linked
        request.auth.uid == sessionId || // TV checking its own session
        resource.data.get('uid', '') == request.auth.uid // Phone checking the session it scanned
      );

      // Initialization (Waiting for scan)
      allow create: if isValidId(sessionId) && 
                       isValidTVSession() && 
                       incoming().status == 'waiting';

      // Updates (Linking or Heartbeats)
      allow update: if isValidTVSession() && (
        // Action: Phone Linking
        (incoming().status == 'linked' && 
         incoming().diff(existing()).affectedKeys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'linkedAt', 'status', 'updatedAt']) &&
         isSignedIn() && request.auth.token.email_verified == true) ||
        // Action: TV Heartbeat
        (incoming().status in ['waiting', 'active'] && 
         incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt', 'status']) &&
         request.auth.uid == sessionId)
      );

      allow delete: if (resource.data.uid == request.auth.uid || request.auth.uid == sessionId);
    }

    match /uploads/{uploadId} {
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.anonUid == request.auth.uid
      );
      
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.anonUid == request.auth.uid
      );

      allow create: if isSignedIn() && 
                       isValidRemoteUpload() && 
                       incoming().userId == request.auth.uid;
      
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
